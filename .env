# =============================================================================
# Non-secret platform configuration, read automatically by `docker compose`.
# This file is SAFE TO COMMIT: it must never contain passwords, keys or tokens.
# Secrets live encrypted in ./secrets (see secrets/README.md).
# =============================================================================

# --- Versions ----------------------------------------------------------------
AIRFLOW_VERSION=3.3.2
PYTHON_VERSION=3.12
MLFLOW_VERSION=3.17.0
SOPS_VERSION=3.13.3
POSTGRES_IMAGE=postgres:17
# MinIO removed its images from Docker Hub/Quay in 2026. This is the free,
# rebuilt MinIO image published by Chainguard (only the "latest" tag is free).
# Any S3-compatible server works here - see docker/README.md for alternatives.
MINIO_IMAGE=cgr.dev/chainguard/minio:latest

# --- Network -----------------------------------------------------------------
# 127.0.0.1 = reachable only from this machine. Use 0.0.0.0 to expose on the LAN
# (then also add your host name/IP to MLFLOW_ALLOWED_HOSTS below).
BIND_ADDRESS=127.0.0.1
AIRFLOW_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MLFLOW_PORT=5000
JUPYTER_PORT=8888
MLFLOW_ALLOWED_HOSTS=mlflow,mlflow:*,localhost,localhost:*,127.0.0.1,127.0.0.1:*

# --- Data lake buckets (one per layer) ---------------------------------------
LAKE_BUCKET_STAGING=staging
LAKE_BUCKET_BRONZE=bronze
LAKE_BUCKET_SILVER=silver
LAKE_BUCKET_GOLD=gold
LAKE_BUCKET_MLFLOW=mlflow
# Files in the staging area are deleted automatically after this many days.
STAGING_RETENTION_DAYS=30

# --- Processing engine (DuckDB) ----------------------------------------------
# Memory each DuckDB process may use before spilling to disk, and its threads.
DUCKDB_MEMORY_LIMIT=2GB
DUCKDB_THREADS=4

# --- Airflow -----------------------------------------------------------------
# Timezone used for cron schedules and for the date partitions of the lake.
PLATFORM_TIMEZONE=America/Sao_Paulo
# Maximum number of tasks running at the same time.
AIRFLOW_PARALLELISM=8
AIRFLOW_API_WORKERS=2
# Concurrent extractions allowed against the source MySQL (protects production).
MYSQL_SOURCE_POOL_SLOTS=2
# On Linux hosts set this to the output of `id -u` so bind-mounted folders stay
# writable. On Windows/macOS keep the default.
AIRFLOW_UID=50000

# --- dbt ---------------------------------------------------------------------
# Set to false once you no longer want the bundled example models to run.
DBT_ENABLE_EXAMPLES=true

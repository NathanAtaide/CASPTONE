	partition 'Forecast Backtest' = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(GoldFolder & "gld_forecast_backtest_monthly.parquet")),
				    Selected = Table.SelectColumns(Source, {"target", "model_key", "market", "is_total", "month_date_key", "forecast", "forecast_seed_min", "forecast_seed_max", "actual", "error", "abs_error", "error_pct"}),
				    Keyed = Table.AddColumn(Selected, "model_id", each [target] & "|" & [model_key], type text)
				in
				    Keyed

	annotation PBI_ResultType = Table


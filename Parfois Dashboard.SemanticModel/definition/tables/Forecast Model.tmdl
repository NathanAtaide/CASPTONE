	partition 'Forecast Model' = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(GoldFolder & "gld_forecast_model_metrics.parquet")),
				    Selected = Table.SelectColumns(Source, {"target", "model_key", "model_name", "family", "algorithm", "scenario", "uses_paid_media", "level", "is_champion", "is_baseline_reference", "rank_wape", "within_tie_of_best", "wape_monthly", "bias_monthly", "rmse_monthly", "r2_monthly", "wape_daily", "wape_monthly_es", "bias_monthly_es", "wape_monthly_pt", "bias_monthly_pt", "wape_seed_mean", "wape_seed_min", "wape_seed_max", "baseline_wape_monthly", "wape_vs_baseline_pp", "beats_baseline", "training_seconds", "mlflow_experiment", "mlflow_run_id", "backtest_start", "backtest_end"}),
				    Keyed = Table.AddColumn(Selected, "model_id", each [target] & "|" & [model_key], type text),
				    Labeled = Table.AddColumn(Keyed, "model_label", each (if [is_champion] then "★ " else "") & [model_name], type text),
				    Typed = Table.AddColumn(Labeled, "family_short", each
				        if [family] = "Machine Learning" then "ML" else if [family] = "Deep Learning" then "DL" else [family], type text)
				in
				    Typed

	annotation PBI_ResultType = Table


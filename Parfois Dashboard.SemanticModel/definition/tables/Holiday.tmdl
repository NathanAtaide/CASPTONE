	column 'Holiday Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: f662c776-26b8-5a30-9fb9-f755fb13c9e7
		summarizeBy: none
		sourceColumn: holiday_sk

		annotation SummarizationSetBy = Automatic

	column 'Holiday ID'

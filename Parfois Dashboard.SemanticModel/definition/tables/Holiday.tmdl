		annotation SummarizationSetBy = Automatic

	column 'Holiday Country Code'
		dataType: string
		lineageTag: 250a8d1c-d040-50a6-8537-c4205205e103
		summarizeBy: none
		sourceColumn: country_code

		annotation SummarizationSetBy = Automatic

	column Nationwide
		dataType: boolean
		lineageTag: 1d011938-dbd6-5b37-8637-316b7f357260
		summarizeBy: none
		sourceColumn: is_nationwide


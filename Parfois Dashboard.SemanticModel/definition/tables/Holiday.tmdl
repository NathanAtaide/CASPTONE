		summarizeBy: none
		sourceColumn: holiday_types

		annotation SummarizationSetBy = Automatic

	partition Holiday = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(GoldFolder & "gld_dim_holiday.parquet")),
				    Selected = Table.SelectColumns(Source, {"holiday_sk", "holiday_id", "country_code", "is_nationwide", "holiday_date", "holiday_name", "local_name", "holiday_types"})
				in
				    Selected

	annotation PBI_ResultType = Table


	/// Sales Under Campaign % of the previous month.
	measure 'Sales Under Campaign % PM' =
			VAR _target = EDATE ( [Selected Month Start], -1 )
			RETURN
			    CALCULATE (
			        [Sales Under Campaign %],
			        REMOVEFILTERS ( 'Month Selector' ),
			        TREATAS ( { _target }, 'Month Selector'[Month Start] )
			    )
		formatString: 0.0%
		displayFolder: 3 Comparisons
		lineageTag: a6e744b0-0fc4-58fb-bc2b-b20545474cbe

	/// Sales Under Campaign % of the same month last year.
	measure 'Sales Under Campaign % PY' =
			VAR _target = EDATE ( [Selected Month Start], -12 )
			RETURN
			    CALCULATE (
			        [Sales Under Campaign %],
			        REMOVEFILTERS ( 'Month Selector' ),
			        TREATAS ( { _target }, 'Month Selector'[Month Start] )
			    )
		formatString: 0.0%
		displayFolder: 3 Comparisons
		lineageTag: eb84f5ec-3f90-57fe-883a-89a55081c984

	/// Sales Under Campaign % minus the previous month (percentage points).
	measure 'Sales Under Campaign % MoM Δ' =
			VAR _current = [Sales Under Campaign %]
			VAR _previous = [Sales Under Campaign % PM]
			RETURN
			    IF ( NOT ISBLANK ( _current ) && NOT ISBLANK ( _previous ), _current - _previous )
		formatString: 0.0%
		displayFolder: 3 Comparisons
		lineageTag: 07750ae6-7bc5-59f7-85bf-18e612d413b2

	/// Sales Under Campaign % minus the same month last year (percentage points).

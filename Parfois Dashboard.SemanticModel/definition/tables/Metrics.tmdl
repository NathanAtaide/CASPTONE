		lineageTag: bcc71d80-187e-5d1f-88a2-9078ab8fd513

	measure 'Discount Rate Change B Colour' = IF ( [Is Annual View], "#1C1C1C", [Discount Rate vs Last Year Colour] )
		displayFolder: 7 Labels and colours
		lineageTag: e7d0866a-554a-5571-b9bc-52a393136a94

	/// Sales Under Campaign % of the previous period.
	measure 'Sales Under Campaign % Previous' =
			VAR _target = EDATE ( [Selected Month Start], IF ( [Is Annual View], -12, -1 ) )
			RETURN
			    CALCULATE (
			        [Sales Under Campaign %],
			        REMOVEFILTERS ( 'Month Selector' ),
			        TREATAS ( { _target }, 'Month Selector'[Month Start] )
			    )
		formatString: 0.0%
		displayFolder: 3 Comparisons
		lineageTag: bc7b0b78-6d7f-5456-8b81-56bb73bdaedc

	/// Sales Under Campaign % minus the previous period (percentage points).
	measure 'Sales Under Campaign % vs Previous Δ' =
			VAR _current = [Sales Under Campaign %]
			VAR _previous = [Sales Under Campaign % Previous]
			RETURN
			    IF ( NOT ISBLANK ( _current ) && NOT ISBLANK ( _previous ), _current - _previous )
		formatString: 0.0%
		displayFolder: 3 Comparisons
		lineageTag: 145932cf-ae3d-5ea1-a8c5-faf0594ed6c0

	/// Sales Under Campaign % minus the same period last year (percentage points).
	measure 'Sales Under Campaign % vs Last Year Δ' =
			VAR _current = [Sales Under Campaign %]
			VAR _previous = [Sales Under Campaign % PY]
			RETURN
			    IF ( NOT ISBLANK ( _current ) && NOT ISBLANK ( _previous ), _current - _previous )
		formatString: 0.0%
		displayFolder: 3 Comparisons
		lineageTag: 26730bab-168e-5dea-826c-fb1e77dd8bfd

	measure 'Sales Under Campaign % Change A' =
			VAR _d = [Sales Under Campaign % vs Previous Δ]
			RETURN
			    IF ( ISBLANK ( _d ), "n/a", IF ( _d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _d ) * 100, "0.0", "en-US" ) & " pp" )
		displayFolder: 7 Labels and colours
		lineageTag: 8705c4b0-3c4a-5972-88f0-ffd14fca137a

	measure 'Sales Under Campaign % Change B' =
			VAR _d = [Sales Under Campaign % vs Last Year Δ]
			VAR _v = [Sales Under Campaign % PY]
			RETURN
			    IF ( [Is Annual View], IF ( ISBLANK ( _v ), "n/a", FORMAT ( _v, "0.0%", "en-US" ) ), IF ( ISBLANK ( _d ), "n/a", IF ( _d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _d ) * 100, "0.0", "en-US" ) & " pp" ) )
		displayFolder: 7 Labels and colours
		lineageTag: aed76cd6-5e10-5cc9-802b-8f1118acabc0

	measure 'Sales Under Campaign % Change A Colour' =
			VAR _delta = [Sales Under Campaign % vs Previous Δ]
			RETURN
			    IF ( ISBLANK ( _delta ), "#8C8781", "#1C1C1C" )
		displayFolder: 7 Labels and colours
		lineageTag: 1ca8c759-d0ce-5ee6-9a1f-b6918e02e231

	measure 'Sales Under Campaign % vs Last Year Colour' =
			VAR _delta = [Sales Under Campaign % vs Last Year Δ]
			RETURN
			    IF ( ISBLANK ( _delta ), "#8C8781", "#1C1C1C" )
		displayFolder: 7 Labels and colours
		lineageTag: 19b69a27-62d4-589b-a7e7-3d95f4a0fe5c

	measure 'Sales Under Campaign % Change B Colour' = IF ( [Is Annual View], "#1C1C1C", [Sales Under Campaign % vs Last Year Colour] )
		displayFolder: 7 Labels and colours
		lineageTag: 059f4b8d-dfcf-56fa-a9a7-596d64a0ed15

	/// Revenue tile: year to date (Month view) or the annual budget (Year view).
	measure 'Revenue Tile Detail' = IF ( [Is Annual View], [Revenue Budget], [Revenue YTD] )
		formatString: \€#,0;-\€#,0;\€#,0
		displayFolder: 7 Labels and colours
		lineageTag: c0bc8063-5a65-528c-84b0-f4e89131d902

	measure 'Revenue Tile Detail Label' = IF ( [Is Annual View], YEAR ( [Selected Month Start] ) & " budget", "year to date" )
		displayFolder: 7 Labels and colours
		lineageTag: deb06599-55b6-513e-99ad-6ccc9e03730a

	/// Orders tile: year to date (Month view) or the monthly average (Year view).
	measure 'Orders Tile Detail' = IF ( [Is Annual View], [Orders Monthly Average], [Orders YTD] )
		formatString: #,0
		displayFolder: 7 Labels and colours
		lineageTag: 9c6a4c40-f5cd-5d84-b561-a11f8ab25642

	/// Units Sold tile: year to date (Month view) or the monthly average (Year view).
	measure 'Units Sold Tile Detail' = IF ( [Is Annual View], [Units Sold Monthly Average], [Units Sold YTD] )
		formatString: #,0
		displayFolder: 7 Labels and colours
		lineageTag: 603d4719-0a40-5280-bb74-5e351033f4e2

	/// Average Order Value tile: year to date (Month view) or the monthly average (Year view).
	measure 'Average Order Value Tile Detail' = IF ( [Is Annual View], [Average Order Value Monthly Average], [Average Order Value YTD] )
		formatString: \€#,0.00;-\€#,0.00;\€#,0.00
		displayFolder: 7 Labels and colours
		lineageTag: 6e40571a-f32f-522f-8ab5-57273ed15c7a

	/// Market shown on the Forecast page: the Market slicer, or ES + PT (total) when nothing is selected.
	measure 'Forecast Market Selected' = SELECTEDVALUE ( 'Forecast Market'[Market], "ES + PT" )
		isHidden
		displayFolder: 5 Forecast
		lineageTag: 74b7ac05-4331-5568-a55e-f9c2e9b7b90d

	/// Latest month forecast by the models (gld_forecast_next_month).
	measure 'Next Forecast Month' =
			CALCULATE (
			    MAX ( 'Forecast Next Month'[Forecast Month] ),
			    REMOVEFILTERS ( 'Forecast Next Month' ),
			    REMOVEFILTERS ( 'Date' )
			)
		formatString: mmm yyyy
		displayFolder: 5 Forecast
		lineageTag: 70f244d9-87f5-5cf1-bc1a-13417225fd93

	/// Model forecast for the latest forecast month, market of the page. Orders, net units or gross sales (EUR) depending on the target.
	measure 'Next Month Forecast' =
			VAR _market = [Forecast Market Selected]
			VAR _month = [Next Forecast Month]
			RETURN
			    CALCULATE (
			        SUM ( 'Forecast Next Month'[Forecast] ),
			        'Forecast Market'[Market] = _market,
			        'Forecast Next Month'[Forecast Month] = _month
			    )
		formatString: #,0
		displayFolder: 5 Forecast
		lineageTag: 4c919ad6-ec69-5148-9fe0-a4b1693f53e5

	/// Next Month Forecast with euro format (gross sales).
	measure 'Next Month Forecast €' = [Next Month Forecast]
		formatString: \€#,0;-\€#,0;\€#,0
		displayFolder: 5 Forecast
		lineageTag: 79b83850-c953-509c-b5a7-a2b674cd90d9

	/// Actual value of the backtest months in the target definition of the models (read from one model, the same for all).
	measure 'Backtest Actual' =
			VAR _market = [Forecast Market Selected]
			RETURN
			    CALCULATE (
			        SUM ( 'Forecast Backtest'[Actual] ),
			        'Forecast Market'[Market] = _market,
			        'Forecast Model'[Baseline Reference] = TRUE ()
			    )
		formatString: #,0
		displayFolder: 5 Forecast
		lineageTag: 0d771dce-0ba8-5776-923d-8f8deaf96f4f

	/// Assumptions of the forecast, shown in the strip of the Forecast page.
	measure 'Forecast Assumptions' =
			VAR _month = [Next Forecast Month]
			VAR _budget =
			    CALCULATE (
			        MAX ( 'Forecast Next Month'[Paid Media Budget] ),
			        REMOVEFILTERS ( 'Forecast Next Month' ), REMOVEFILTERS ( 'Forecast Target' ),
			        'Forecast Next Month'[Forecast Month] = _month, 'Forecast Next Month'[Is Total] = TRUE ()
			    )
			VAR _notes =
			    CALCULATE (
			        MAX ( 'Forecast Next Month'[Notes] ),
			        REMOVEFILTERS ( 'Forecast Next Month' ), REMOVEFILTERS ( 'Forecast Target' ),
			        'Forecast Next Month'[Forecast Month] = _month
			    )
			VAR _calendar =
			    IF ( CONTAINSSTRING ( _notes, "repeated" ), "  ·  event calendar of the same month last year repeated", "" )
			RETURN
			    "Each month is forecast with data up to 2 months before (M-2)"
			        & IF ( NOT ISBLANK ( _budget ),
			            "  ·  paid media budget assumed for " & FORMAT ( _month, "mmm yyyy", "en-US" ) & ": €" & FORMAT ( _budget, "#,0", "en-US" ),
			            "" )
			        & _calendar
		displayFolder: 5 Forecast
		lineageTag: a7c8ce57-140e-5741-9b7d-12d7243fbae8

	/// Orders from January up to the selected month.
	measure 'Orders YTD' =
			VAR _month = [Selected Month Start]
			RETURN
			    CALCULATE (
			        [_Orders],
			        KEEPFILTERS ( 'Date'[Month Start] >= DATE ( YEAR ( _month ), 1, 1 ) && 'Date'[Month Start] <= _month )
			    )
		formatString: #,0
		displayFolder: 1 Sales
		lineageTag: 83ec77a5-2234-522c-bca4-b347d6a31d57

	/// Units sold from January up to the selected month.
	measure 'Units Sold YTD' =
			VAR _month = [Selected Month Start]
			RETURN
			    CALCULATE (
			        [_Units Sold],
			        KEEPFILTERS ( 'Date'[Month Start] >= DATE ( YEAR ( _month ), 1, 1 ) && 'Date'[Month Start] <= _month )
			    )
		formatString: #,0
		displayFolder: 1 Sales
		lineageTag: 28a6ee75-88d6-5186-9278-59d06495060b

	/// Revenue / orders from January up to the selected month.
	measure 'Average Order Value YTD' = DIVIDE ( [Revenue YTD], [Orders YTD] )
		formatString: \€#,0.00;-\€#,0.00;\€#,0.00
		displayFolder: 1 Sales
		lineageTag: 420f4cc9-0d8e-52e4-bdc4-6e20652f3f9e

	/// Last month with both a model forecast (cutoff M-2) and the actual value.
	measure 'Last Backtest Month' =
			VAR _end = CALCULATE ( MAX ( 'Forecast Target'[Backtest End] ), REMOVEFILTERS ( 'Forecast Target' ) )
			RETURN
			    DATE ( YEAR ( _end ), MONTH ( _end ), 1 )
		formatString: mmm yyyy
		isHidden
		displayFolder: 5 Forecast
		lineageTag: a61d91e4-0c04-57ec-adc5-980672480a69

	/// Model used to forecast the target (chosen by the forecasting pipeline).
	measure 'Forecast Model Name' = SELECTEDVALUE ( 'Forecast Target'[Champion Model] )
		displayFolder: 5 Forecast
		lineageTag: 090a4e8a-7865-5edb-9f25-f495d94bda26

	/// Forecast the model made for each backtest month, trained with data up to the end of M-2.
	measure 'Backtest Forecast' =
			VAR _market = [Forecast Market Selected]
			RETURN
			    CALCULATE (
			        SUM ( 'Forecast Backtest'[Forecast] ),
			        'Forecast Market'[Market] = _market,
			        'Forecast Model'[Champion] = TRUE ()
			    )
		formatString: #,0
		displayFolder: 5 Forecast
		lineageTag: 44d040b4-fd98-566b-ac94-56148c55109d

	/// Forecast line of the chart: backtest months, then the next month.
	measure 'Forecast (Chart)' =
			VAR _backtest = [Backtest Forecast]
			RETURN
			    IF ( NOT ISBLANK ( _backtest ), _backtest, [Next Month Forecast] )
		formatString: #,0
		displayFolder: 5 Forecast
		lineageTag: e90ed208-7a8f-5f7a-b6d4-7f5295404ac1

	/// 1 - WAPE of the model over the last 3 backtest months (sum of absolute errors / sum of actuals).
	measure 'Forecast Accuracy 3M' =
			VAR _last = [Last Backtest Month]
			VAR _months =
			    CALCULATETABLE (
			        VALUES ( 'Date'[Month Start] ),
			        REMOVEFILTERS ( 'Date' ),
			        'Date'[Month Start] > EDATE ( _last, -3 ) && 'Date'[Month Start] <= _last
			    )
			VAR _points = ADDCOLUMNS ( _months, "@actual", CALCULATE ( [Backtest Actual] ), "@forecast", CALCULATE ( [Backtest Forecast] ) )
			VAR _actual = SUMX ( _points, [@actual] )
			VAR _error = SUMX ( _points, ABS ( [@forecast] - [@actual] ) )
			RETURN
			    IF ( _actual > 0, 1 - DIVIDE ( _error, _actual ) )
		formatString: 0.0%
		displayFolder: 5 Forecast
		lineageTag: a5ddbe03-e63d-5a40-9b4e-ae6b5e35782d

	/// TRUE on the last 3 backtest months of a 'Date' month axis.
	measure 'Is Forecast Table Month' =
			VAR _axis = MAX ( 'Date'[Month Start] )
			VAR _single = MIN ( 'Date'[Month Start] ) = _axis
			VAR _last = [Last Backtest Month]
			RETURN
			    _single && _axis > EDATE ( _last, -3 ) && _axis <= _last
		isHidden
		displayFolder: 5 Forecast\Accuracy table
		lineageTag: 0297ac3c-60b9-52a8-a763-bb8815d28e40

	/// Gross Sales: actual value of the last 3 backtest months.
	measure 'Gross Sales Actual (Table)' = IF ( [Is Forecast Table Month], CALCULATE ( [Backtest Actual], REMOVEFILTERS ( 'Forecast Target' ), 'Forecast Target'[Target Key] = "sales" ) )
		formatString: \€#,0;-\€#,0;\€#,0
		displayFolder: 5 Forecast\Accuracy table
		lineageTag: ce32eb7a-3f11-50f5-bcb8-a441b9187269

	/// Gross Sales: model forecast of the last 3 backtest months and of the next month.
	measure 'Gross Sales Forecast (Table)' =
			VAR _axis = MAX ( 'Date'[Month Start] )
			VAR _single = MIN ( 'Date'[Month Start] ) = _axis
			RETURN
			    SWITCH (
			        TRUE (),
			        [Is Forecast Table Month], CALCULATE ( [Backtest Forecast], REMOVEFILTERS ( 'Forecast Target' ), 'Forecast Target'[Target Key] = "sales" ),
			        _single && _axis = [Next Forecast Month], CALCULATE ( [Next Month Forecast], REMOVEFILTERS ( 'Forecast Target' ), 'Forecast Target'[Target Key] = "sales" )
			    )
		formatString: \€#,0;-\€#,0;\€#,0
		displayFolder: 5 Forecast\Accuracy table
		lineageTag: 1a5151cf-2cbd-5e85-84f9-9841a4a4a33d

	/// Gross Sales: 1 - absolute percentage error of the month.
	measure 'Gross Sales Accuracy (Table)' =
			VAR _actual = [Gross Sales Actual (Table)]
			VAR _forecast = [Gross Sales Forecast (Table)]
			RETURN
			    IF (
			        NOT ISBLANK ( _actual ) && NOT ISBLANK ( _forecast ) && _actual <> 0,
			        MAX ( 0, 1 - ABS ( _forecast - _actual ) / ABS ( _actual ) )
			    )
		formatString: 0.0%
		displayFolder: 5 Forecast\Accuracy table
		lineageTag: 8477007b-9c28-519f-9801-5b2f8a88b5aa

	/// Orders: actual value of the last 3 backtest months.
	measure 'Orders Actual (Table)' = IF ( [Is Forecast Table Month], CALCULATE ( [Backtest Actual], REMOVEFILTERS ( 'Forecast Target' ), 'Forecast Target'[Target Key] = "orders" ) )
		formatString: #,0
		displayFolder: 5 Forecast\Accuracy table
		lineageTag: a6ce86ad-c486-561a-af13-d3e8c15680d4

	/// Orders: model forecast of the last 3 backtest months and of the next month.
	measure 'Orders Forecast (Table)' =
			VAR _axis = MAX ( 'Date'[Month Start] )
			VAR _single = MIN ( 'Date'[Month Start] ) = _axis
			RETURN
			    SWITCH (
			        TRUE (),
			        [Is Forecast Table Month], CALCULATE ( [Backtest Forecast], REMOVEFILTERS ( 'Forecast Target' ), 'Forecast Target'[Target Key] = "orders" ),
			        _single && _axis = [Next Forecast Month], CALCULATE ( [Next Month Forecast], REMOVEFILTERS ( 'Forecast Target' ), 'Forecast Target'[Target Key] = "orders" )
			    )
		formatString: #,0
		displayFolder: 5 Forecast\Accuracy table
		lineageTag: 1bda07f1-3ac0-5c1d-9513-640df70b12b2

	/// Orders: 1 - absolute percentage error of the month.
	measure 'Orders Accuracy (Table)' =
			VAR _actual = [Orders Actual (Table)]
			VAR _forecast = [Orders Forecast (Table)]
			RETURN
			    IF (
			        NOT ISBLANK ( _actual ) && NOT ISBLANK ( _forecast ) && _actual <> 0,
			        MAX ( 0, 1 - ABS ( _forecast - _actual ) / ABS ( _actual ) )
			    )
		formatString: 0.0%
		displayFolder: 5 Forecast\Accuracy table
		lineageTag: aee18b9c-74f9-51cf-a8fa-adc6260406e1

	/// Net Units: actual value of the last 3 backtest months.
	measure 'Net Units Actual (Table)' = IF ( [Is Forecast Table Month], CALCULATE ( [Backtest Actual], REMOVEFILTERS ( 'Forecast Target' ), 'Forecast Target'[Target Key] = "units" ) )
		formatString: #,0
		displayFolder: 5 Forecast\Accuracy table
		lineageTag: bae9cae9-17de-550f-9c17-d300bf33df2d

	/// Net Units: model forecast of the last 3 backtest months and of the next month.
	measure 'Net Units Forecast (Table)' =
			VAR _axis = MAX ( 'Date'[Month Start] )
			VAR _single = MIN ( 'Date'[Month Start] ) = _axis
			RETURN
			    SWITCH (
			        TRUE (),
			        [Is Forecast Table Month], CALCULATE ( [Backtest Forecast], REMOVEFILTERS ( 'Forecast Target' ), 'Forecast Target'[Target Key] = "units" ),
			        _single && _axis = [Next Forecast Month], CALCULATE ( [Next Month Forecast], REMOVEFILTERS ( 'Forecast Target' ), 'Forecast Target'[Target Key] = "units" )
			    )
		formatString: #,0
		displayFolder: 5 Forecast\Accuracy table
		lineageTag: dd6cfb4c-23ee-5121-aef9-51ee23aab2e1

	/// Net Units: 1 - absolute percentage error of the month.
	measure 'Net Units Accuracy (Table)' =
			VAR _actual = [Net Units Actual (Table)]
			VAR _forecast = [Net Units Forecast (Table)]
			RETURN
			    IF (
			        NOT ISBLANK ( _actual ) && NOT ISBLANK ( _forecast ) && _actual <> 0,
			        MAX ( 0, 1 - ABS ( _forecast - _actual ) / ABS ( _actual ) )
			    )
		formatString: 0.0%
		displayFolder: 5 Forecast\Accuracy table
		lineageTag: 095ca568-3b57-5199-b942-d1390719c73a

	column Value
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 2d43708f-a06c-58e9-b415-ce5a8dfd282b
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition Metrics = calculated
		mode: import
		source = { 0 }


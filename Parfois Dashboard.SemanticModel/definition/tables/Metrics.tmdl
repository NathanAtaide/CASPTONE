		formatString: \€#,0.00;-\€#,0.00;\€#,0.00
		displayFolder: 5 Forecast
		lineageTag: a0960b08-4235-5f56-af39-7f049c9760f4

	measure 'Average Order Value Forecast Accuracy' =
			VAR _actual = [Average Order Value]
			VAR _forecast = DIVIDE ( [Revenue Forecast], [Orders Forecast] )
			RETURN
			    IF (
			        NOT ISBLANK ( _actual ) && NOT ISBLANK ( _forecast ) && _actual <> 0,
			        MAX ( 0, 1 - ABS ( _actual - _forecast ) / ABS ( _actual ) )
			    )
		formatString: 0.0%
		displayFolder: 5 Forecast
		lineageTag: 03359fcc-7271-5cbc-8e98-b759dc1b090e

	/// TRUE when the selected month ended less than 30 days before the last sales date: returns are still being booked, so revenue and return rate are provisional.
	measure 'Is Provisional' =
			VAR _lastKey = CALCULATE ( MAX ( Sales[Order Date Key] ), ALL () )
			VAR _lastDate = DATE ( INT ( _lastKey / 10000 ), MOD ( INT ( _lastKey / 100 ), 100 ), MOD ( _lastKey, 100 ) )
			RETURN
			    EOMONTH ( [Selected Month Start], 0 ) > _lastDate - 30
		displayFolder: 0 Period
		lineageTag: b8f7103a-c8fe-545f-962a-577c648c0502

	/// Revenue in a campaign context versus a normal day of the same markets in the same month.
	measure 'Campaign Uplift %' =
			-- Expected revenue = for each market, its days in this context x its average revenue per day in the month,
			-- so big and small markets are compared with themselves.
			VAR _expected =
			    SUMX (
			        VALUES ( Market[Market Key] ),
			        [Market-Days with Sales] * CALCULATE ( [Avg Revenue per Market-Day], REMOVEFILTERS ( 'Campaign Context' ) )
			    )
			RETURN
			    IF ( _expected > 0, DIVIDE ( [Revenue], _expected ) - 1 )
		formatString: ▲ 0.0%;▼ 0.0%;0.0%
		displayFolder: 6 Marketing
		lineageTag: 1e8e70bc-788b-5982-8783-8e393fa6fb6c

	column Value
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 2d43708f-a06c-58e9-b415-ce5a8dfd282b
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition Metrics = calculated
		mode: import
		source = { 0 }


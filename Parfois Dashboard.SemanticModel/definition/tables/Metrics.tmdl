	measure 'Discount Rate (Trend)' =
			VAR _month = [Selected Month Start]
			RETURN
			    CALCULATE ( IF ( NOT ISBLANK ( [_Full Price Sales] ), 1 - DIVIDE ( [_Net Sales], [_Full Price Sales] ) ), KEEPFILTERS ( 'Date'[Month Start] > EDATE ( _month, -12 ) && 'Date'[Month Start] <= _month ) )
		formatString: 0.0%
		displayFolder: 4 Trends
		lineageTag: 0cd0f6b3-f6ca-5aa6-ba82-de940995b5a1

	/// TRUE when the selected month ended less than 30 days before the last sales date: returns are still being booked, so revenue and return rate are provisional.
	measure 'Is Provisional' =
			VAR _lastKey = CALCULATE ( MAX ( Sales[Order Date Key] ), ALL () )
			VAR _lastDate = DATE ( INT ( _lastKey / 10000 ), MOD ( INT ( _lastKey / 100 ), 100 ), MOD ( _lastKey, 100 ) )
			RETURN
			    EOMONTH ( [Selected Month Start], 0 ) > _lastDate - 30
		displayFolder: 0 Period
		lineageTag: b8f7103a-c8fe-545f-962a-577c648c0502

	/// Revenue in a campaign context versus a normal day of the same markets in the same period.
	measure 'Campaign Uplift %' =
			-- Expected revenue = for each market, its days in this context x its average revenue per day in the period,
			-- so big and small markets are compared with themselves.
			VAR _expected =
			    SUMX (
			        VALUES ( Market[Market Key] ),
			        [Market-Days with Sales] * CALCULATE ( [Avg Revenue per Market-Day], REMOVEFILTERS ( 'Campaign Context' ) )
			    )
			RETURN
			    IF ( _expected > 0, DIVIDE ( [Revenue], _expected ) - 1 )
		formatString: ▲ 0.0%;▼ 0.0%;0.0%
		displayFolder: 6 Marketing
		lineageTag: 1e8e70bc-788b-5982-8783-8e393fa6fb6c

	/// TRUE when the Month / Year toggle is on Year: KPIs then show the year to date up to the selected month.
	measure 'Is Annual View' = SELECTEDVALUE ( 'Period View'[Period View], "Month" ) = "Year"
		displayFolder: 0 Period
		lineageTag: 3e13c460-ee21-5354-a4a3-49e2b7f700b0

	/// First month of the period shown: the selected month (Month view) or January of its year (Year view).
	measure 'Period Start' =
			VAR _month = [Selected Month Start]
			RETURN
			    IF ( [Is Annual View], DATE ( YEAR ( _month ), 1, 1 ), _month )
		formatString: mmm yyyy
		displayFolder: 0 Period
		lineageTag: ca495b96-2b5b-5efe-8c0b-e67cce77e9e6

	/// Average revenue per month of the period.
	measure 'Revenue Monthly Average' =
			VAR _start = [Period Start]
			VAR _end = [Selected Month Start]
			VAR _months =
			    CALCULATETABLE (
			        VALUES ( 'Date'[Month Start] ),
			        REMOVEFILTERS ( 'Date' ),
			        'Date'[Month Start] >= _start && 'Date'[Month Start] <= _end
			    )
			RETURN
			    AVERAGEX ( _months, CALCULATE ( [_Net Sales] ) )
		formatString: \€#,0;-\€#,0;\€#,0
		displayFolder: 1 Sales
		lineageTag: 981a615c-cea8-54c3-8124-f6a807106bf4

	/// Average orders per month of the period.
	measure 'Orders Monthly Average' =

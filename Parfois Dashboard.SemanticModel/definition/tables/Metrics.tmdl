/// Home of every measure of the dashboard, organised in display folders.
table Metrics
	lineageTag: dd8eefe6-11f9-5759-be29-6589caeb3338

	/// Last month of the period shown: the month picked in the Month slicer, or the latest complete month.
	measure 'Selected Month Start' = MAX ( 'Month Selector'[Month Start] )
		formatString: mmm yyyy
		displayFolder: 0 Period
		lineageTag: c69bc491-a30d-5189-9d24-5de4c44215a5

	measure 'Selected Month Label' = FORMAT ( [Selected Month Start], "mmmm yyyy", "en-US" )
		displayFolder: 0 Period
		lineageTag: 1028899c-8828-5b41-a8e3-b144e9ce49c6

	/// Header subtitle: period shown and the comparison periods.
	measure 'Report Subtitle' =
			VAR _month = [Selected Month Start]
			VAR _provisional = IF ( [Is Provisional], " (provisional)", "" )
			RETURN
			    IF (
			        [Is Annual View],
			        FORMAT ( DATE ( YEAR ( _month ), 1, 1 ), "mmm", "en-US" ) & "–" & FORMAT ( _month, "mmm yyyy", "en-US" )
			            & _provisional & "   ·   vs "
			            & FORMAT ( DATE ( YEAR ( _month ) - 1, 1, 1 ), "mmm", "en-US" ) & "–"
			            & FORMAT ( EDATE ( _month, -12 ), "mmm yyyy", "en-US" ),
			        FORMAT ( _month, "mmmm yyyy", "en-US" ) & _provisional
			            & "   ·   vs " & FORMAT ( EDATE ( _month, -1 ), "mmm yyyy", "en-US" )
			            & " and " & FORMAT ( EDATE ( _month, -12 ), "mmm yyyy", "en-US" )
			    )
		displayFolder: 0 Period
		lineageTag: 7c261d55-747a-535d-be2c-35fefae98d5d

	/// Header subtitle of the Forecast page.
	measure 'Forecast Subtitle' =
			VAR _month = [Next Forecast Month]
			VAR _dataEnd = CALCULATE ( MAX ( 'Forecast Next Month'[Data End] ), REMOVEFILTERS ( 'Forecast Next Month' ) )
			RETURN
			    "Forecast for " & FORMAT ( _month, "mmmm yyyy", "en-US" ) & " · " & [Forecast Market Selected]
			        & "   ·   sales data through " & FORMAT ( _dataEnd, "d mmm yyyy", "en-US" )
		displayFolder: 0 Period
		lineageTag: 12254837-3a44-5d5c-91a2-f2337dd86d0e

	measure 'Data Through' =
			VAR _lastKey = CALCULATE ( MAX ( Sales[Order Date Key] ), ALL () )
			VAR _lastDate = DATE ( INT ( _lastKey / 10000 ), MOD ( INT ( _lastKey / 100 ), 100 ), MOD ( _lastKey, 100 ) )
			RETURN
			    "Sales data through " & FORMAT ( _lastDate, "d mmm yyyy", "en-US" )
		displayFolder: 0 Period
		lineageTag: 986bc3f9-f659-51bf-a70c-68f96302c3ef

	measure '_Net Sales' = SUM ( Sales[Net Amount] )
		formatString: \€#,0;-\€#,0;\€#,0
		isHidden
		displayFolder: 9 Base
		lineageTag: 7d070191-cb18-58cb-922e-41af0e698e68

	measure '_Full Price Sales' = SUM ( Sales[Full Price Amount] )
		formatString: \€#,0;-\€#,0;\€#,0
		isHidden
		displayFolder: 9 Base
		lineageTag: 385e6267-836f-5bfe-a161-5a251ebf84da

	measure '_Gross Sales' = CALCULATE ( [_Net Sales], Sales[Movement Type Key] = 1 )
		formatString: \€#,0;-\€#,0;\€#,0
		isHidden
		displayFolder: 9 Base
		lineageTag: 906c06c5-6269-5607-9a1c-83bb87b6dbc1

	measure _Returns = CALCULATE ( [_Net Sales], Sales[Movement Type Key] = 2 )
		formatString: \€#,0;-\€#,0;\€#,0
		isHidden
		displayFolder: 9 Base
		lineageTag: 6f743ad4-7254-5975-a2f8-7cc74956b056

	measure _Cancellations = CALCULATE ( [_Net Sales], Sales[Movement Type Key] = 3 )
		formatString: \€#,0;-\€#,0;\€#,0
		isHidden
		displayFolder: 9 Base
		lineageTag: 1c3fabb7-2a75-5a28-bd99-d5e6ab965dec

	measure '_Units Sold' = CALCULATE ( SUM ( Sales[Quantity] ), Sales[Movement Type Key] = 1 )
		formatString: #,0
		isHidden
		displayFolder: 9 Base
		lineageTag: 481dd69a-ec99-5fb6-bc54-a4c5b32abae5

	measure '_Units Returned' = - CALCULATE ( SUM ( Sales[Quantity] ), Sales[Movement Type Key] = 2 )
		formatString: #,0
		isHidden
		displayFolder: 9 Base
		lineageTag: a1b440ef-cc27-51ca-b4b1-d1f8ae602959

	measure '_Units Cancelled' = - CALCULATE ( SUM ( Sales[Quantity] ), Sales[Movement Type Key] = 3 )
		formatString: #,0
		isHidden
		displayFolder: 9 Base
		lineageTag: ba211662-1614-5236-846b-1f18c707e6a3

	measure _Orders = CALCULATE ( DISTINCTCOUNT ( Sales[Order ID] ), Sales[Movement Type Key] = 1 )
		formatString: #,0
		isHidden
		displayFolder: 9 Base
		lineageTag: c1ffa0f8-dbc0-53d6-b72a-d55f9844a9ca

	measure _Customers =
			CALCULATE (
			    DISTINCTCOUNT ( Customer[Customer ID] ),
			    Sales,
			    Customer[Customer Key] <> 0
			)
		formatString: #,0
		isHidden
		displayFolder: 9 Base
		lineageTag: 6a4681c7-89fc-5e8d-8fdf-2e35cbf7116d

	measure '_Paid Media' = SUM ( 'Marketing Activity'[Paid Media Amount] )
		formatString: \€#,0;-\€#,0;\€#,0
		isHidden
		displayFolder: 9 Base
		lineageTag: 33f5dae3-6e0d-5a0f-a906-9f93460c37a1

	/// Net sales of the selected period (sales + returns + cancellations), EUR without VAT, after discount.
	measure Revenue =
			VAR _start = [Period Start]
			VAR _end = [Selected Month Start]
			RETURN
			    CALCULATE ( [_Net Sales], KEEPFILTERS ( 'Date'[Month Start] >= _start && 'Date'[Month Start] <= _end ) )
		formatString: \€#,0;-\€#,0;\€#,0
		displayFolder: 1 Sales
		lineageTag: 103c7122-4132-566c-81c8-e08031b13195

	/// Sales lines only (movement type 1).
	measure 'Gross Sales' =
			VAR _start = [Period Start]
			VAR _end = [Selected Month Start]
			RETURN
			    CALCULATE ( [_Gross Sales], KEEPFILTERS ( 'Date'[Month Start] >= _start && 'Date'[Month Start] <= _end ) )
		formatString: \€#,0;-\€#,0;\€#,0
		displayFolder: 1 Sales
		lineageTag: cd9db9c6-429c-571b-ad95-0753f80392fb

	/// Returned amount (movement type 2), negative.
	measure Returns =
			VAR _start = [Period Start]
			VAR _end = [Selected Month Start]
			RETURN
			    CALCULATE ( [_Returns], KEEPFILTERS ( 'Date'[Month Start] >= _start && 'Date'[Month Start] <= _end ) )
		formatString: \€#,0;-\€#,0;\€#,0
		displayFolder: 1 Sales
		lineageTag: d3051567-66ee-5ef9-9e9b-4a40f45e22c8

	/// Cancelled amount (movement type 3), negative.
	measure Cancellations =
			VAR _start = [Period Start]
			VAR _end = [Selected Month Start]
			RETURN
			    CALCULATE ( [_Cancellations], KEEPFILTERS ( 'Date'[Month Start] >= _start && 'Date'[Month Start] <= _end ) )
		formatString: \€#,0;-\€#,0;\€#,0
		displayFolder: 1 Sales
		lineageTag: 8e054f2d-caca-5147-84bc-ce784350ccb1

	/// Catalog value before discount.
	measure 'Full Price Sales' =
			VAR _start = [Period Start]
			VAR _end = [Selected Month Start]
			RETURN
			    CALCULATE ( [_Full Price Sales], KEEPFILTERS ( 'Date'[Month Start] >= _start && 'Date'[Month Start] <= _end ) )
		formatString: \€#,0;-\€#,0;\€#,0
		displayFolder: 1 Sales
		lineageTag: b94c3aab-e73f-5ee2-be09-dd8534e27d59

	/// Distinct orders with at least one sale line.
	measure Orders =
			VAR _start = [Period Start]
			VAR _end = [Selected Month Start]
			RETURN
			    CALCULATE ( [_Orders], KEEPFILTERS ( 'Date'[Month Start] >= _start && 'Date'[Month Start] <= _end ) )
		formatString: #,0
		displayFolder: 1 Sales
		lineageTag: d40496ae-a6a1-51b0-b48a-bb7cd48359d4

	/// Units on sale lines.
	measure 'Units Sold' =
			VAR _start = [Period Start]
			VAR _end = [Selected Month Start]
			RETURN
			    CALCULATE ( [_Units Sold], KEEPFILTERS ( 'Date'[Month Start] >= _start && 'Date'[Month Start] <= _end ) )
		formatString: #,0
		displayFolder: 1 Sales
		lineageTag: 061eb814-1666-5fd2-92a6-b53a1f7f7c11

	/// Units returned (positive number).
	measure 'Units Returned' =
			VAR _start = [Period Start]
			VAR _end = [Selected Month Start]
			RETURN
			    CALCULATE ( [_Units Returned], KEEPFILTERS ( 'Date'[Month Start] >= _start && 'Date'[Month Start] <= _end ) )
		formatString: #,0
		displayFolder: 1 Sales
		lineageTag: e2b82093-04e9-5e8a-beb8-3ab6b529f532

	/// Units cancelled (positive number).
	measure 'Units Cancelled' =
			VAR _start = [Period Start]
			VAR _end = [Selected Month Start]
			RETURN
			    CALCULATE ( [_Units Cancelled], KEEPFILTERS ( 'Date'[Month Start] >= _start && 'Date'[Month Start] <= _end ) )
		formatString: #,0
		displayFolder: 1 Sales
		lineageTag: ffd34a47-66b6-520b-bb74-0d43cae04776

	/// Units of each movement type as a positive number. Use with Movement Type on the axis.
	measure 'Units by Movement' =
			VAR _start = [Period Start]
			VAR _end = [Selected Month Start]
			RETURN
			    CALCULATE ( ABS ( SUM ( Sales[Quantity] ) ), KEEPFILTERS ( 'Date'[Month Start] >= _start && 'Date'[Month Start] <= _end ) )
		formatString: #,0
		displayFolder: 1 Sales
		lineageTag: 670de690-2859-55e2-9f82-6f8abe699658

	/// Distinct customers (people, not SCD2 versions).
	measure Customers =
			VAR _start = [Period Start]
			VAR _end = [Selected Month Start]
			RETURN
			    CALCULATE ( [_Customers], KEEPFILTERS ( 'Date'[Month Start] >= _start && 'Date'[Month Start] <= _end ) )
		formatString: #,0
		displayFolder: 1 Sales
		lineageTag: 478ecc40-2187-5710-acb4-ab45b4a16333

	/// Revenue / Orders.
	measure 'Average Order Value' = DIVIDE ( [Revenue], [Orders] )
		formatString: \€#,0.00;-\€#,0.00;\€#,0.00
		displayFolder: 1 Sales
		lineageTag: 2941fc61-9fea-5b93-963c-24d547240d5d

	/// Share of the revenue of the markets currently selected.
	measure 'Revenue Share' = DIVIDE ( [Revenue], CALCULATE ( [Revenue], ALLSELECTED ( Market ) ) )
		formatString: 0.0%
		displayFolder: 1 Sales
		lineageTag: 5bb2e6e1-3f4a-51e1-940e-44fc9bce2dd5

	/// Returned amount / gross sales.
	measure 'Return Rate' = DIVIDE ( - [Returns], [Gross Sales] )
		formatString: 0.0%
		displayFolder: 2 Rates
		lineageTag: 0850bfc7-d4d9-551b-984a-297e1e07dcc7

	/// Cancelled amount / gross sales.
	measure 'Cancellation Rate' = DIVIDE ( - [Cancellations], [Gross Sales] )
		formatString: 0.0%
		displayFolder: 2 Rates
		lineageTag: 2009056c-cf1b-556f-82df-2ba7052f3c9a

	/// 1 - revenue / catalog value: average discount given.
	measure 'Discount Rate' =
			VAR _fullPrice = [Full Price Sales]
			RETURN
			    IF ( NOT ISBLANK ( _fullPrice ) && _fullPrice <> 0, 1 - DIVIDE ( [Revenue], _fullPrice ) )
		formatString: 0.0%
		displayFolder: 2 Rates
		lineageTag: ff04e8a1-99b0-5c4f-90de-1389cd995438

	/// Share of revenue made on market-days with paid media, an event or a nationwide holiday.
	measure 'Sales Under Campaign %' =
			DIVIDE (
			    CALCULATE ( [Revenue], KEEPFILTERS ( 'Campaign Context'[Campaign Context Key] >= 2 ) ),
			    [Revenue]
			)
		formatString: 0.0%
		displayFolder: 2 Rates
		lineageTag: ed1fae25-d137-593c-88f0-64d45eac53d5

	/// Paid media spend of the selected period.
	measure 'Paid Media Spend' =
			VAR _start = [Period Start]
			VAR _end = [Selected Month Start]
			RETURN
			    CALCULATE ( [_Paid Media], KEEPFILTERS ( 'Date'[Month Start] >= _start && 'Date'[Month Start] <= _end ) )
		formatString: \€#,0;-\€#,0;\€#,0
		displayFolder: 6 Marketing
		lineageTag: 7ce43dde-f414-59ab-8f7b-4b5377dd9e56

	/// Revenue per euro of paid media (all origins of the selected markets).
	measure ROAS = DIVIDE ( [Revenue], [Paid Media Spend] )
		formatString: #,0.0\x
		displayFolder: 6 Marketing
		lineageTag: bfa63fca-2835-5f43-8a75-2ce720a6d681

	/// Days of the period with at least one commercial event running.
	measure 'Event Days' =
			VAR _start = [Period Start]
			VAR _end = [Selected Month Start]
			RETURN
			    CALCULATE ( CALCULATE ( DISTINCTCOUNT ( 'Marketing Activity'[Date Key] ), 'Marketing Activity'[Event Key] <> 0 ), KEEPFILTERS ( 'Date'[Month Start] >= _start && 'Date'[Month Start] <= _end ) )
		formatString: #,0
		displayFolder: 6 Marketing
		lineageTag: 0cc80500-813d-5640-a7bb-7e02a78b31f9

	/// Days of the period with a nationwide holiday in at least one selected market.
	measure 'Holiday Days' =
			VAR _start = [Period Start]
			VAR _end = [Selected Month Start]
			RETURN
			    CALCULATE ( CALCULATE ( DISTINCTCOUNT ( 'Marketing Activity'[Date Key] ), 'Marketing Activity'[Holiday Key] <> 0, Holiday[Nationwide] = TRUE () ), KEEPFILTERS ( 'Date'[Month Start] >= _start && 'Date'[Month Start] <= _end ) )
		formatString: #,0
		displayFolder: 6 Marketing
		lineageTag: cbf7d003-293a-5caa-8c26-d14736e93b23

	/// Distinct commercial events active in the period.
	measure 'Events Running' =
			VAR _start = [Period Start]
			VAR _end = [Selected Month Start]
			RETURN
			    CALCULATE ( CALCULATE ( DISTINCTCOUNT ( 'Marketing Activity'[Event Key] ), 'Marketing Activity'[Event Key] <> 0 ), KEEPFILTERS ( 'Date'[Month Start] >= _start && 'Date'[Month Start] <= _end ) )
		formatString: #,0
		displayFolder: 6 Marketing
		lineageTag: 7bee2f19-529f-50f9-9e45-82d420e4150e

	measure 'Market-Days with Sales' =
			VAR _start = [Period Start]
			VAR _end = [Selected Month Start]
			RETURN
			    CALCULATE ( COUNTROWS ( SUMMARIZE ( Sales, Sales[Order Date Key], Sales[Market Key] ) ), KEEPFILTERS ( 'Date'[Month Start] >= _start && 'Date'[Month Start] <= _end ) )
		formatString: #,0
		isHidden
		displayFolder: 6 Marketing
		lineageTag: 9487dc61-d765-5b15-9e45-2eb2456aa701

	/// Average revenue of one market on one day. Compares campaign contexts fairly.
	measure 'Avg Revenue per Market-Day' = DIVIDE ( [Revenue], [Market-Days with Sales] )
		formatString: \€#,0;-\€#,0;\€#,0
		displayFolder: 6 Marketing
		lineageTag: 456a4580-38ee-56e9-bc4a-098457fe32ae

	measure 'Event Market-Days' =
			VAR _start = [Period Start]
			VAR _end = [Selected Month Start]
			RETURN
			    CALCULATE (
			        COUNTROWS ( SUMMARIZE ( 'Marketing Activity', 'Marketing Activity'[Date Key], 'Marketing Activity'[Market Key] ) ),
			        KEEPFILTERS ( 'Date'[Month Start] >= _start && 'Date'[Month Start] <= _end ),
			        'Marketing Activity'[Event Key] <> 0
			    )
		formatString: #,0
		isHidden
		displayFolder: 6 Marketing
		lineageTag: 45bb6f0b-c90d-55ce-a05d-f9337776269c

	/// Revenue made in the markets and days where the event applied.
	measure 'Revenue on Event Days' =
			VAR _start = [Period Start]
			VAR _end = [Selected Month Start]
			VAR _pairs =
			    CALCULATETABLE (
			        SUMMARIZE ( 'Marketing Activity', 'Marketing Activity'[Date Key], 'Marketing Activity'[Market Key] ),
			        KEEPFILTERS ( 'Date'[Month Start] >= _start && 'Date'[Month Start] <= _end ),
			        'Marketing Activity'[Event Key] <> 0
			    )
			RETURN
			    CALCULATE ( [_Net Sales], TREATAS ( _pairs, Sales[Order Date Key], Sales[Market Key] ) )
		formatString: \€#,0;-\€#,0;\€#,0
		displayFolder: 6 Marketing
		lineageTag: 2293f833-8cca-50ef-a564-7fd6762724ea

	/// Revenue on the event days versus a normal day of the same markets in the same period.
	measure 'Event Uplift %' =
			-- Expected revenue = for each market, its event days x its average revenue per day in the period.
			VAR _actual = [Revenue on Event Days]
			VAR _expected =
			    SUMX ( VALUES ( Market[Market Key] ), [Event Market-Days] * [Avg Revenue per Market-Day] )
			RETURN
			    IF ( NOT ISBLANK ( _actual ) && _expected > 0, DIVIDE ( _actual, _expected ) - 1 )
		formatString: ▲ 0.0%;▼ 0.0%;0.0%
		displayFolder: 6 Marketing
		lineageTag: a9620125-b657-5744-838d-6b127fb0530e

	measure 'Holiday Market-Days' =
			VAR _start = [Period Start]
			VAR _end = [Selected Month Start]
			RETURN
			    CALCULATE (
			        COUNTROWS ( SUMMARIZE ( 'Marketing Activity', 'Marketing Activity'[Date Key], 'Marketing Activity'[Market Key] ) ),
			        KEEPFILTERS ( 'Date'[Month Start] >= _start && 'Date'[Month Start] <= _end ),
			        'Marketing Activity'[Holiday Key] <> 0, Holiday[Nationwide] = TRUE ()
			    )
		formatString: #,0
		isHidden
		displayFolder: 6 Marketing
		lineageTag: a5021781-40d0-5093-8b42-99fcf7627499

	/// Revenue made in the markets and days where the holiday applied (nationwide holidays only).
	measure 'Revenue on Holiday Days' =
			VAR _start = [Period Start]
			VAR _end = [Selected Month Start]
			VAR _pairs =
			    CALCULATETABLE (
			        SUMMARIZE ( 'Marketing Activity', 'Marketing Activity'[Date Key], 'Marketing Activity'[Market Key] ),
			        KEEPFILTERS ( 'Date'[Month Start] >= _start && 'Date'[Month Start] <= _end ),
			        'Marketing Activity'[Holiday Key] <> 0, Holiday[Nationwide] = TRUE ()
			    )
			RETURN
			    CALCULATE ( [_Net Sales], TREATAS ( _pairs, Sales[Order Date Key], Sales[Market Key] ) )
		formatString: \€#,0;-\€#,0;\€#,0
		displayFolder: 6 Marketing
		lineageTag: 8b3c8903-1bf7-5932-996b-60c66d7eb3f7

	/// Revenue on the holiday days versus a normal day of the same markets in the same period.
	measure 'Holiday Uplift %' =
			-- Expected revenue = for each market, its holiday days x its average revenue per day in the period.
			VAR _actual = [Revenue on Holiday Days]
			VAR _expected =
			    SUMX ( VALUES ( Market[Market Key] ), [Holiday Market-Days] * [Avg Revenue per Market-Day] )
			RETURN
			    IF ( NOT ISBLANK ( _actual ) && _expected > 0, DIVIDE ( _actual, _expected ) - 1 )
		formatString: ▲ 0.0%;▼ 0.0%;0.0%
		displayFolder: 6 Marketing
		lineageTag: 17488e24-14c0-55ef-bc12-5ad4584267e2

	/// Bar colour of the daily chart: taupe = event day, rose = nationwide holiday, black = regular day.
	measure 'Day Colour' =
			VAR _start = [Period Start]
			VAR _end = [Selected Month Start]
			VAR _event =
			    CALCULATE ( COUNTROWS ( 'Marketing Activity' ), KEEPFILTERS ( 'Date'[Month Start] >= _start && 'Date'[Month Start] <= _end ), 'Marketing Activity'[Event Key] <> 0 ) > 0
			VAR _holiday =
			    CALCULATE ( COUNTROWS ( 'Marketing Activity' ), KEEPFILTERS ( 'Date'[Month Start] >= _start && 'Date'[Month Start] <= _end ), 'Marketing Activity'[Holiday Key] <> 0, Holiday[Nationwide] = TRUE () ) > 0
			RETURN
			    SWITCH ( TRUE (), _event, "#A58D74", _holiday, "#D9A39A", "#1C1C1C" )
		displayFolder: 7 Labels and colours
		lineageTag: 00258b45-5908-58c8-8d0b-848bed3b46bd

	/// Tooltip: events running on the day.
	measure 'Events on Day' =
			VAR _start = [Period Start]
			VAR _end = [Selected Month Start]
			RETURN
			    CONCATENATEX (
			        CALCULATETABLE ( VALUES ( Event[Event] ), CALCULATETABLE ( 'Marketing Activity', KEEPFILTERS ( 'Date'[Month Start] >= _start && 'Date'[Month Start] <= _end ) ), Event[Event Key] <> 0 ),
			        Event[Event],
			        ", "
			    )
		displayFolder: 6 Marketing
		lineageTag: 6ae6b46c-5154-5a4f-a68a-a23ae91634d5

	/// Tooltip: nationwide holidays on the day.
	measure 'Holidays on Day' =
			VAR _start = [Period Start]
			VAR _end = [Selected Month Start]
			RETURN
			    CONCATENATEX (
			        CALCULATETABLE ( VALUES ( Holiday[Holiday] ), CALCULATETABLE ( 'Marketing Activity', KEEPFILTERS ( 'Date'[Month Start] >= _start && 'Date'[Month Start] <= _end ) ), Holiday[Holiday Key] <> 0, Holiday[Nationwide] = TRUE () ),
			        Holiday[Holiday],
			        ", "
			    )
		displayFolder: 6 Marketing
		lineageTag: aad984b5-ff7b-594a-9e6e-ad86ecbff9c7

	/// Revenue of the same period one year earlier.
	measure 'Revenue PY' =
			VAR _target = EDATE ( [Selected Month Start], -12 )
			RETURN
			    CALCULATE (
			        [Revenue],
			        REMOVEFILTERS ( 'Month Selector' ),
			        TREATAS ( { _target }, 'Month Selector'[Month Start] )
			    )
		formatString: \€#,0;-\€#,0;\€#,0
		displayFolder: 3 Comparisons
		lineageTag: 71c25fc3-4192-5882-8dc5-5b7b3a919c87

	/// Orders of the same period one year earlier.
	measure 'Orders PY' =
			VAR _target = EDATE ( [Selected Month Start], -12 )
			RETURN
			    CALCULATE (
			        [Orders],
			        REMOVEFILTERS ( 'Month Selector' ),
			        TREATAS ( { _target }, 'Month Selector'[Month Start] )
			    )
		formatString: #,0
		displayFolder: 3 Comparisons
		lineageTag: acf82877-9de8-5447-b2d9-fa240ded092b

	/// Units Sold of the same period one year earlier.
	measure 'Units Sold PY' =
			VAR _target = EDATE ( [Selected Month Start], -12 )
			RETURN
			    CALCULATE (
			        [Units Sold],
			        REMOVEFILTERS ( 'Month Selector' ),
			        TREATAS ( { _target }, 'Month Selector'[Month Start] )
			    )
		formatString: #,0
		displayFolder: 3 Comparisons
		lineageTag: bb677e98-e5aa-5982-b762-6fbe469c8fe8

	/// Average Order Value of the same period one year earlier.
	measure 'Average Order Value PY' =
			VAR _target = EDATE ( [Selected Month Start], -12 )
			RETURN
			    CALCULATE (
			        [Average Order Value],
			        REMOVEFILTERS ( 'Month Selector' ),
			        TREATAS ( { _target }, 'Month Selector'[Month Start] )
			    )
		formatString: \€#,0.00;-\€#,0.00;\€#,0.00
		displayFolder: 3 Comparisons
		lineageTag: 732cc98d-1473-52ec-870a-8f80211cb285

	/// Gross Sales of the same period one year earlier.
	measure 'Gross Sales PY' =
			VAR _target = EDATE ( [Selected Month Start], -12 )
			RETURN
			    CALCULATE (
			        [Gross Sales],

	/// Average of the monthly average order values of the period.
	measure 'Average Order Value Monthly Average' =
			VAR _start = [Period Start]
			VAR _end = [Selected Month Start]
			VAR _months =
			    CALCULATETABLE (
			        VALUES ( 'Date'[Month Start] ),
			        REMOVEFILTERS ( 'Date' ),
			        'Date'[Month Start] >= _start && 'Date'[Month Start] <= _end
			    )
			RETURN
			    AVERAGEX ( _months, CALCULATE ( DIVIDE ( [_Net Sales], [_Orders] ) ) )
		formatString: \€#,0.00;-\€#,0.00;\€#,0.00
		displayFolder: 1 Sales
		lineageTag: fcf67626-5dcb-54e6-a48a-f69e2555300b

	/// Annual revenue budget of the selected year: previous-year revenue x (1 + planned growth from 'Budget Assumptions'). Follows the market and origin filters.
	measure 'Revenue Budget' =
			-- Annual revenue budget of the year of the selected month:
			--   budget = revenue of the previous year x (1 + planned growth of the year).
			-- When the previous year is not in the data (2024), its revenue is rebuilt from the reported growth:
			--   previous year = revenue of the year / (1 + reported growth of the year).
			-- Edit the growth rates in the calculated table 'Budget Assumptions'.
			VAR _year = YEAR ( [Selected Month Start] )
			VAR _plannedGrowth = LOOKUPVALUE ( 'Budget Assumptions'[Planned Growth], 'Budget Assumptions'[Year], _year )
			VAR _reportedGrowth = LOOKUPVALUE ( 'Budget Assumptions'[Reported Growth], 'Budget Assumptions'[Year], _year )
			VAR _previousYear = CALCULATE ( [_Net Sales], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = _year - 1 )
			VAR _currentYear = CALCULATE ( [_Net Sales], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = _year )
			VAR _base =
			    IF ( NOT ISBLANK ( _previousYear ), _previousYear, DIVIDE ( _currentYear, 1 + _reportedGrowth ) )
			RETURN
			    IF ( NOT ISBLANK ( _plannedGrowth ) && NOT ISBLANK ( _base ), _base * ( 1 + _plannedGrowth ) )
		formatString: \€#,0;-\€#,0;\€#,0
		displayFolder: 8 Budget
		lineageTag: 3a8d847e-08ca-52f6-8dde-baf81eba47cc

	/// Revenue from January up to the selected month.
	measure 'Revenue YTD' =
			VAR _month = [Selected Month Start]
			RETURN
			    CALCULATE (
			        [_Net Sales],
			        KEEPFILTERS ( 'Date'[Month Start] >= DATE ( YEAR ( _month ), 1, 1 ) && 'Date'[Month Start] <= _month )
			    )
		formatString: \€#,0;-\€#,0;\€#,0
		displayFolder: 8 Budget
		lineageTag: d84d4000-b487-56b8-9bc9-0da7334227d4

	/// Share of the annual budget already achieved: revenue year to date / annual budget.
	measure 'Budget Attainment' = DIVIDE ( [Revenue YTD], [Revenue Budget] )

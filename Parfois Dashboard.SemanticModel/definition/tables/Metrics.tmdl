	/// PLACEHOLDER forecast of revenue for the month in context. Replace with the ML model output; every other forecast measure reads this one.
	measure 'Revenue Forecast (Model)' =
			-- PLACEHOLDER until the ML forecast Parquet exists. Replace this whole expression with the
			-- model output for the month in the filter context, for example:
			--     SUM ( 'Sales Forecast'[revenue_forecast] )
			-- Current logic (seasonal naive with trend): same month last year x growth of the last
			-- 3 months versus the same 3 months one year earlier (no trend while that history is missing).
			-- Uses only data before the month.
			VAR _month = MAX ( 'Date'[Month Start] )
			VAR _sameMonthLastYear =
			    CALCULATE ( [_Net Sales], REMOVEFILTERS ( 'Date' ), 'Date'[Month Start] = EDATE ( _month, -12 ) )
			VAR _last3Months =
			    CALCULATE ( [_Net Sales], REMOVEFILTERS ( 'Date' ), 'Date'[Month Start] >= EDATE ( _month, -3 ) && 'Date'[Month Start] < _month )
			VAR _sameMonthsLastYear =
			    CALCULATE ( [_Net Sales], REMOVEFILTERS ( 'Date' ), 'Date'[Month Start] >= EDATE ( _month, -15 ) && 'Date'[Month Start] < EDATE ( _month, -12 ) )
			VAR _hasFullHistory =
			    NOT ISBLANK ( CALCULATE ( [_Net Sales], REMOVEFILTERS ( 'Date' ), 'Date'[Month Start] = EDATE ( _month, -15 ) ) )
			VAR _trend = IF ( _hasFullHistory, DIVIDE ( _last3Months, _sameMonthsLastYear ), 1 )
			RETURN
			    IF ( NOT ISBLANK ( _sameMonthLastYear ) && NOT ISBLANK ( _trend ), _sameMonthLastYear * _trend )
		formatString: \€#,0;-\€#,0;\€#,0
		displayFolder: 5 Forecast\Model output (replace)
		lineageTag: fa6348ad-da82-519a-aa8f-7a3dea60c56e

	/// Forecast of revenue for the selected month (compare with the actual value).
	measure 'Revenue Forecast' =
			VAR _month = [Selected Month Start]
			RETURN
			    CALCULATE ( [Revenue Forecast (Model)], REMOVEFILTERS ( 'Date' ), 'Date'[Month Start] = _month )
		formatString: \€#,0;-\€#,0;\€#,0
		displayFolder: 5 Forecast
		lineageTag: e2746478-7aef-5a77-a850-9a0f3bea5447

	/// Forecast of revenue for the month after the selected one.
	measure 'Revenue Forecast Next Month' =
			VAR _month = [Selected Month Start]
			RETURN
			    CALCULATE ( [Revenue Forecast (Model)], REMOVEFILTERS ( 'Date' ), 'Date'[Month Start] = EDATE ( _month, 1 ) )
		formatString: \€#,0;-\€#,0;\€#,0
		displayFolder: 5 Forecast
		lineageTag: 81f39090-4052-5a9e-92ff-6d13395b56e6

	/// 1 - absolute percentage error of the revenue forecast in the selected month.
	measure 'Revenue Forecast Accuracy' =
			VAR _actual = [Revenue]
			VAR _forecast = [Revenue Forecast]
			RETURN
			    IF (
			        NOT ISBLANK ( _actual ) && NOT ISBLANK ( _forecast ) && _actual <> 0,
			        MAX ( 0, 1 - ABS ( _actual - _forecast ) / ABS ( _actual ) )
			    )
		formatString: 0.0%
		displayFolder: 5 Forecast
		lineageTag: c714e082-9da2-54c4-afcb-b10ed4cac469

	/// 1 - MAPE of the revenue forecast over the 6 months up to the selected month.
	measure 'Revenue Forecast Accuracy 6M' =
			VAR _month = [Selected Month Start]
			VAR _months =
			    CALCULATETABLE (
			        VALUES ( 'Date'[Month Start] ),
			        REMOVEFILTERS ( 'Date' ),
			        'Date'[Month Start] > EDATE ( _month, -6 ) && 'Date'[Month Start] <= _month
			    )
			VAR _points =
			    ADDCOLUMNS ( _months, "@actual", CALCULATE ( [_Net Sales] ), "@forecast", CALCULATE ( [Revenue Forecast (Model)] ) )
			VAR _mape =
			    AVERAGEX (
			        FILTER ( _points, NOT ISBLANK ( [@actual] ) && NOT ISBLANK ( [@forecast] ) && [@actual] <> 0 ),
			        ABS ( [@actual] - [@forecast] ) / ABS ( [@actual] )
			    )
			RETURN
			    IF ( NOT ISBLANK ( _mape ), MAX ( 0, 1 - _mape ) )
		formatString: 0.0%
		displayFolder: 5 Forecast
		lineageTag: b1233366-9455-596a-b7ad-438b8d133b0f

	/// Forecast of revenue for the 12 months up to the selected month plus the next month.
	measure 'Revenue Forecast (Trend)' =
			VAR _month = [Selected Month Start]
			VAR _axis = MAX ( 'Date'[Month Start] )
			VAR _single = MIN ( 'Date'[Month Start] ) = _axis
			RETURN
			    IF ( _single && _axis > EDATE ( _month, -12 ) && _axis <= EDATE ( _month, 1 ), [Revenue Forecast (Model)] )
		formatString: \€#,0;-\€#,0;\€#,0
		displayFolder: 4 Trends
		lineageTag: 096e8774-79c2-5f95-a50a-584a2c9b2894

	measure 'Revenue Forecast Accuracy (Trend)' =

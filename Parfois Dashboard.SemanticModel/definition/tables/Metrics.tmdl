	/// Monthly revenue of the 12 months up to the selected month.
	measure 'Revenue (Trend)' =
			VAR _month = [Selected Month Start]
			RETURN
			    CALCULATE ( [_Net Sales], KEEPFILTERS ( 'Date'[Month Start] > EDATE ( _month, -12 ) && 'Date'[Month Start] <= _month ) )
		formatString: \€#,0;-\€#,0;\€#,0
		displayFolder: 4 Trends
		lineageTag: 7d3eb661-e12c-5928-ad29-4dc70d2dc8ec

	/// Revenue of the same month one year earlier, for each month of the trend.
	measure 'Revenue LY (Trend)' =
			VAR _month = [Selected Month Start]
			VAR _axis = MAX ( 'Date'[Month Start] )
			VAR _single = MIN ( 'Date'[Month Start] ) = _axis
			RETURN
			    IF (
			        _single && _axis > EDATE ( _month, -12 ) && _axis <= _month,
			        CALCULATE ( [_Net Sales], REMOVEFILTERS ( 'Date' ), 'Date'[Month Start] = EDATE ( _axis, -12 ) )
			    )
		formatString: \€#,0;-\€#,0;\€#,0
		displayFolder: 4 Trends
		lineageTag: 71d2e79c-3bcd-54d7-90b4-4dac0351f77b

	measure 'Return Rate (Trend)' =

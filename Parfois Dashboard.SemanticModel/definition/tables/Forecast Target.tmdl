	partition 'Forecast Target' = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(GoldFolder & "gld_forecast_champion.parquet")),
				    Selected = Table.SelectColumns(Source, {"target", "target_label", "model_key", "model_name", "family", "algorithm", "scenario", "uses_paid_media", "wape_monthly", "bias_monthly", "wape_daily", "baseline_wape_monthly", "wape_vs_baseline_pp", "beats_baseline", "runner_up_model_key", "runner_up_wape_monthly", "best_ml_dl_model_name", "best_ml_dl_wape_monthly", "registered_model_name", "registered_model_version", "mlflow_run_id", "backtest_start", "backtest_end", "data_end", "selection_rule", "selected_at"}),
				    Named = Table.AddColumn(Selected, "target_name", each
				        if [target] = "orders" then "Orders"
				        else if [target] = "units" then "Net units"
				        else if [target] = "sales" then "Gross sales"
				        else [target_label], type text),
				    Ordered = Table.AddColumn(Named, "target_order", each
				        if [target] = "orders" then 1 else if [target] = "units" then 2 else if [target] = "sales" then 3 else 9,
				        Int64.Type)
				in
				    Ordered

	annotation PBI_ResultType = Table


# Files executed inside Linux containers must keep LF line endings, even when
# the repository is checked out on Windows (CRLF breaks shebangs and YAML keys).
* text=auto
*.sh        text eol=lf
*.py        text eol=lf
*.sql       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.env       text eol=lf
.env        text eol=lf
Dockerfile  text eol=lf
*.ipynb     text eol=lf
*.parquet   binary
